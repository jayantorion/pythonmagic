# ==============================================================================
# AI Job Search & Application Intelligence Platform Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production
APP_TITLE="AI Job Search & Application Intelligence Platform"
API_V1_STR=/api/v1

# Storage Engine (Dual-Mode: SQLite for zero-config local, PostgreSQL for cloud)
# Default SQLite (no Docker required):
DATABASE_URL=sqlite+aiosqlite:///./data/job_agent.db

# Production PostgreSQL with pgvector (uncomment when using Docker / Cloud):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_agent

# AI Provider Configuration
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-20241022

# Embedding Configuration (local_numpy or openai)
EMBEDDING_PROVIDER=local_tfidf_or_mock
OPENAI_API_KEY=

# Job Discovery API Credentials (Optional - public feeds work without them)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Frontend CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
